 "captions": [
  {
   "t0": 0.0,
   "t1": 1.6,
   "text": "Meilleur tour de la séance."
  },
  {
   "t0": 1.94,
   "t1": 3.5,
   "text": "Le tour parfait n'en garde que"
  },
  {
   "t0": 3.5,
   "t1": 5.21,
   "text": "9 morceaux sur 49."
  },
  {
   "t0": 5.48,
   "t1": 6.54,
   "text": "D'où viennent les autres ?"
  },
  {
   "t0": 6.9,
   "t1": 8.71,
   "text": "Voilà comment on construit ce tour."
  },
  {
   "t0": 9.09,
   "t1": 10.87,
   "text": "On découpe la piste en petits bouts."
  },
  {
   "t0": 11.24,
   "t1": 12.09,
   "text": "Pour chacun, on prend"
  },
  {
   "t0": 12.09,
   "t1": 14.54,
   "text": "le passage le plus rapide de la séance."
  },
  {
   "t0": 14.77,
   "t1": 17.16,
   "text": "Regarde : ce bout vient d'un tour."
  },
  {
   "t0": 17.39,
   "t1": 18.82,
   "text": "Le suivant, d'un autre."
  },
  {
   "t0": 19.14,
   "t1": 20.25,
   "text": "Dans ton tour parfait,"
  },
  {
   "t0": 20.35,
   "t1": 22.16,
   "text": "chaque bout, tu l'as déjà roulé."
  },
  {
   "t0": 22.52,
   "t1": 24.96,
   "text": "Ta règle : vise d'abord ce tour-là."
  },
  {
   "t0": 25.25,
   "t1": 27.66,
   "text": "Envoie ça au pote qui ne parle que de son chrono."
  }
 ]
